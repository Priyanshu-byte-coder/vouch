# Copy to .env and fill in. Never commit .env.

# Scholarly APIs
CROSSREF_MAILTO=
OPENALEX_API_KEY=
# Extra OpenAlex keys, used in turn once one hits its daily budget
OPENALEX_API_KEY_2=
OPENALEX_API_KEY_3=
S2_API_KEY=
# Semantic Scholar allows 1 request/second across all endpoints; stay just under it
S2_MIN_INTERVAL=1.1

# LLM (any OpenAI-compatible endpoint)
LLM_BASE_URL=https://api.vultrinference.com/v1
LLM_API_KEY=
LLM_MODEL_PARSE=deepseek-v4.1-flash-1017
LLM_MODEL_JUDGE=deepseek-v4.1-flash-1017

# Services
GROBID_URL=http://localhost:8070
CACHE_PATH=./cache.sqlite
